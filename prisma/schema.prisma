generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trip {
  id            String   @id @default(uuid())
  userId        String
  destination   String
  days          Int
  itineraryData Json
  createdAt     DateTime @default(now())
}

model PlaceCache {
  id               String   @id @default(uuid())
  cacheKey         String   @unique  // "{normalized-name}|{normalized-city}"
  photoUrl         String?
  rating           Float?
  userRatingsTotal Int?
  hoursOpen        String?
  priceLevel       Int?
  fetchedAt        DateTime @default(now())
}

model CostLog {
  id          String   @id @default(uuid())
  userId      String?                        // Clerk userId — null if unauthenticated
  destination String
  aiCost      Decimal  @db.Decimal(10, 6)
  googleCost  Decimal  @db.Decimal(10, 6)
  totalCost   Decimal  @db.Decimal(10, 6)
  cacheHits   Int
  cacheMisses Int                            // = googleTextSearchCalls (items not in cache)
  createdAt   DateTime @default(now())
}
