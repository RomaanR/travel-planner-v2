generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trip {
  id            String   @id @default(uuid())
  userId        String
  destination   String
  days          Int
  itineraryData Json
  request       Json? // validated generation request (dates, party, pace, hotel, transport…); null on trips saved before 2026-10
  generationId  String? // from the signed save token — makes saving the same generation idempotent
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([userId, generationId]) // one trip per generation per user; NULLs (legacy rows) don't collide
  @@index([userId]) // findMany({ where: { userId } }) on /trips — prevents full table scan at scale
  @@index([userId, createdAt(sort: Desc)]) // ordered archive fetch — covering index avoids sort step
}

model PlaceCache {
  id               String   @id @default(uuid())
  cacheKey         String   @unique // "{normalized-name}|{normalized-city}"
  photoUrl         String? // DEPRECATED — use photoReference; kept for backward compat during natural expiry
  photoReference   String? // raw photo_reference from Google Places (key-independent; URL constructed fresh at serve time)
  placeId          String? // Google Places place_id — used to build accurate Maps URLs with correct names + locations
  rating           Float?
  userRatingsTotal Int?
  hoursOpen        String? // DEPRECATED — single weekday captured at fetch time; use weeklyHours
  weeklyHours      String[] @default([]) // Google weekday_text, Monday first: ["Monday: 9:00 AM – 5:00 PM", …]
  priceLevel       Int?
  lat              Float? // Google's coordinates for the place (Places API New)
  lng              Float?
  googleMapsUri    String? // link to the place on Google Maps
  photoAuthorName  String? // required photo credit (authorAttributions[0].displayName)
  photoAuthorUri   String? // author's Google Maps profile
  detailsLevel     String? // "full" (rating/price/hours) | "basic" (location + photos) — Places API New; null = legacy row
  fetchedAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([updatedAt]) // Cron cleanup: deleteMany({ where: { updatedAt: { lt: 14daysAgo } } }) — O(log n) with index
  @@index([placeId]) // a new spelling of a known place resolves (free ID search) to an existing row
}

model UserProfile {
  id               String   @id // Clerk userId
  availableCredits Int      @default(5) // premium: the balance (10 + bonus per paid period, reserved per generation). free: a reporting snapshot only — see src/lib/credits.ts
  bonusCredits     Int      @default(0) // manually granted extra credits — stacks on the free and premium allowance; set in Supabase directly
  totalGenerations Int      @default(0) // incremented on every successful AI generation (saved or not)
  isPremium        Boolean  @default(false) // true while an active $10.99/month subscription exists
  stripeCustomerId String?  @unique // kept for refund/audit purposes
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CostLog {
  id             String   @id @default(uuid())
  userId         String? // Clerk userId — null if unauthenticated
  destination    String
  inputTokens    Int      @default(0) // exact Anthropic input token count
  outputTokens   Int      @default(0) // exact Anthropic output token count (text only)
  thinkingTokens Int      @default(0) // Adaptive Thinking / reasoning tokens (billed at output rate; 0 when off)
  aiCost         Decimal  @db.Decimal(10, 6)
  googleCost     Decimal  @db.Decimal(10, 6)
  totalCost      Decimal  @db.Decimal(10, 6)
  cacheHits      Int
  cacheMisses    Int // places fetched from Google (paid lookups); legacy rows: Text Search calls
  googleDetailsCalls Int  @default(0) // paid Google Place Details calls
  model          String? // model that produced this generation, e.g. "claude-sonnet-4-6"
  success        Boolean  @default(true) // false when generation failed before completion
  errorType      String? // "max_tokens" | "json_parse" | "incomplete_days" | "generation_error" | "client_abort" — null on success
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)]) // admin dashboard: last 200 rows ordered by createdAt — O(log n) at scale
}

model SupportTicket {
  id        String   @id @default(uuid())
  email     String
  message   String
  status    String   @default("open") // "open" | "resolved" — for future admin triage
  createdAt DateTime @default(now())
}

model StripeEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique // e.g. "evt_1ABC..." — Stripe's own event ID
  type          String // e.g. "checkout.session.completed"
  processedAt   DateTime @default(now()) // row is written in the same transaction as the event's effects — it exists only if they committed
}

// Local mirror of a Stripe subscription. Stripe is the source of truth: every
// subscription/invoice event re-fetches the subscription and overwrites this row,
// so out-of-order webhook delivery cannot leave a stale status behind.
model Subscription {
  id                 String    @id // Stripe subscription ID ("sub_...")
  userId             String // Clerk userId
  stripeCustomerId   String
  status             String // Stripe status: active | trialing | past_due | unpaid | canceled | incomplete | incomplete_expired | paused
  priceId            String?
  cancelAtPeriodEnd  Boolean   @default(false)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  endedAt            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

// Every subscription invoice Stripe reports — the payment record used for revenue,
// refunds and support. creditsGrantedAt makes the monthly credit grant idempotent.
model Invoice {
  id               String    @id // Stripe invoice ID ("in_...")
  userId           String
  subscriptionId   String?
  status           String // Stripe status: draft | open | paid | uncollectible | void
  billingReason    String? // subscription_create | subscription_cycle | subscription_update | manual | ...
  currency         String
  amountDue        Int // minor units (cents)
  amountPaid       Int
  amountRefunded   Int       @default(0)
  paidAt           DateTime?
  hostedInvoiceUrl String?
  creditsGrantedAt DateTime? // set once when this invoice's monthly credits were granted
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, paidAt(sort: Desc)]) // admin revenue: paid invoices, newest first
}

model Dispute {
  id        String   @id // Stripe dispute ID ("dp_...")
  userId    String?
  invoiceId String?
  chargeId  String
  amount    Int
  currency  String
  reason    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
